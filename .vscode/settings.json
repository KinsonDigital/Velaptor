		"Unloadable",
		"unmanaged",
		"unrooted",
		"Unsubscriber",
		"Velaptor",
		"Vorbis",
		"xunit"
	],
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		"**/.idea": true,
		"*.sln.DotSettings.user": true,
		"**/*.lscache": true
	},
	"files.eol": "\n",
	"window.title": "🦖Velaptor",
	"workbench.colorCustomizations": {
		"titleBar.activeBackground": "#5f4f41",
		"titleBar.activeForeground": "#FFFFFF",
		"tab.activeBackground": "#534538",
		"tab.activeForeground": "#e0bb98",
		"tab.activeBorder": "#e0bb98",
		"tab.activeBorderTop": "#e0bb98"
	},
	"workbench.editor.customLabels.patterns": {
		"**/Testing/**/*.cs": "${filename}🧪",
		"**/Velaptor/**/*.cs": "${filename}👾",
		"**/DevTools/**/*.ts": "${filename}🔧",
		"**/.github/workflows/**/*.yml": "${filename}⚙️",
		"**/ReleaseNotes/**/*.md": "${filename}📋",
	},
	"workbench.editor.titleScrollbarSizing": "large",
	"workbench.editor.wrapTabs": true,
	"dotnet.defaultSolution": "Velaptor.sln",
	"[csharp]": {
		"editor.insertSpaces": true,
		"editor.indentSize": 4,
	},
	"[typescript]": {
		"editor.defaultFormatter": "denoland.vscode-deno",
		"editor.insertSpaces": false,
		"editor.tabSize": 4,
	},
	"[jsonc]": {
		"editor.insertSpaces": false,
		"editor.tabSize": 4,
	},
	"[yaml]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 2,
	},
	"editor.detectIndentation": false,
	"[github-actions-workflow]": {
		"editor.tabSize": 2,
		"editor.insertSpaces": true
	}
}
