{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{ // VELAPTOR TESTING
			"name": "VelaptorTesting",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/Testing/VelaptorTesting/bin/Debug/net9.0/VelaptorTesting.dll",
			"cwd": "${workspaceFolder}/Testing/VelaptorTesting",
			"console": "internalConsole",
			"stopAtEntry": false
		},
		{ // PLAYGROUND
			"request": "launch",
			"name": "Playground",
			"type": "node",
			"program": "${workspaceFolder}/DevTools/playground.ts",
			"cwd": "${workspaceFolder}",
			"windows": {
				"runtimeExecutable": "${userHome}/.deno/bin/deno.exe"
			},
			"linux": {
				"runtimeExecutable": "${userHome}/.deno/bin/deno"
			},
			"runtimeArgs": [
				"run",
				"--inspect-wait",
				"--allow-all",
			],
			"attachSimplePort": 9229,
			"console": "integratedTerminal"
		},
		{ // PREP PREV RELEASE
			"request": "launch",
			"name": "Prev Prev Release",
			"type": "node",
			"program": "${workspaceFolder}/DevTools/prep-prev-release.ts",
			"cwd": "${workspaceFolder}",
			"windows": {
				"runtimeExecutable": "${userHome}/.deno/bin/deno.exe"
			},
			"linux": {
				"runtimeExecutable": "${userHome}/.deno/bin/deno"
			},
			"runtimeArgs": [
				"run",
				"--inspect-wait",
				"--allow-all",
			],
			"attachSimplePort": 9229,
			"console": "integratedTerminal"
		},
	]
}
