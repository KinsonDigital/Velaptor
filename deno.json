{
    "tasks": {
        "check": "deno check ./**/*.ts",
        "lint": "deno lint ./**/*.ts",
        "fmt": "deno fmt ./**/*.ts",
        "fmt-check": "deno fmt --check ./**/*.ts",
        "reload-cache": "deno cache ./**/*.ts",
        "create-local-nuget-pkg-debug": "pwsh -File ./DevTools/create-local-nuget-pkg.ps1 -BuildConfig Debug -EnableTelemetry \"true\"",
        "create-local-nuget-pkg-release": "pwsh -File ./DevTools/create-local-nuget-pkg.ps1 -BuildConfig Release -EnableTelemetry \"true\"",
        "create-pr": "deno run -A jsr:@kinsondigital/sprocket@3.0.0 run-job ./DevTools/sprocket-config.ts --job-name Create-PR",
        "prep-prev-release": "deno run -A jsr:@kinsondigital/sprocket@3.0.0 run-job ./DevTools/sprocket-config.ts --job-name Prep-Prev-Release"
    },
    "lint": {
        "include": [
            "DevTools/",
            "tests/"
        ],
        "exclude": [
            "**/playground.ts"
        ]
    },
    "fmt": {
        "include": [
            "DevTools/",
            ".github/actions/",
            ".github/cicd-scripts/"
        ],
        "exclude": [
            "**/*.md",
            "**/*.json",
            "**/*.js",
            "**/*.yml",
            "**/*.yaml",
            "**/playground.ts"
        ],
        "useTabs": true,
        "lineWidth": 130,
        "indentWidth": 4,
        "semiColons": true,
        "singleQuote": false
    },
    "imports": {
        "@std/fs": "jsr:@std/fs@^1.0.24",
        "@cliffy/prompt": "jsr:@cliffy/prompt@1.2.1",
        "@kd-clients/github": "jsr:@kinsondigital/kd-clients@1.0.0-preview.16/github"
    }
}
